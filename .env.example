# sleekculture environment configuration.
# Copy to .env and fill in real values — .env is gitignored and never committed.
# Every value here can also be set as a real OS environment variable
# (real environment always wins over the .env file).

# First boot only: seeds the admin account. Ignored once the admin exists.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-before-first-boot

# Production: require HTTPS for session cookies (set to 1 behind HTTPS).
COOKIE_SECURE=0

# Where the SQLite database and uploaded images live (the entire datastore).
# Default: <project>/data. On PythonAnywhere leave the default — the home
# directory is persistent. On Render/Railway set this to a mounted volume.
# DATA_DIR=/absolute/path/to/data

# API server port (dev). WSGI hosts and platforms inject their own.
PORT=3001

# Sessions and login rate limiting (sane defaults, rarely changed).
SESSION_TTL_HOURS=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=5

# Optional: Exa web search (POST /api/search/web, admin-only).
# Get a key at https://dashboard.exa.ai — leave empty to keep the feature
# switched off; the endpoint then answers 503 instead of failing. Read from
# the environment only — never hard-code or commit it.
EXA_API_KEY=

# Optional: real Paystack server-side verification.
# Leave PAYSTACK_SECRET_KEY unset to keep the current local-dev behavior
# (verify-payment marks pending card orders paid immediately).
# Set it to your sk_test_/sk_live_ key to enable real verification. The key
# is read from the environment only — never hard-code or commit it.
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
