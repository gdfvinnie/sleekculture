# sleekculture environment configuration.
# Copy to .env and fill in real values — .env is gitignored and never committed.
# Every value here can also be set as a real OS environment variable
# (real environment always wins over the .env file).

# --- Frontend build settings (NOT read at runtime) -------------------------
# These are consumed by `npm run build` in frontend/ — set them in your
# hosting provider's build environment, not in a server .env file.
#
# SITE_URL: absolute public address, no trailing slash. Baked into the
# canonical link, og:url/og:image, robots.txt and sitemap.xml. Include a
# sub-path when the site is not at the domain root.
#   SITE_URL=https://sleekculture.ng
#   SITE_URL=https://user.github.io/repo
# Default when unset: https://gdfvinnie.github.io/sleekculture
# SITE_URL=https://example.com
#
# BASE_PATH: only for sub-folder hosting (e.g. /repo). Default "/".
# BASE_PATH=/

# --- Backend runtime -------------------------------------------------------

# First boot only: seeds the admin account. Ignored once the admin exists.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-before-first-boot

# Production: require HTTPS for session cookies (set to 1 behind HTTPS).
COOKIE_SECURE=0

# Where the SQLite database and uploaded images live (the entire datastore).
# Default: <project>/data. On PythonAnywhere leave the default — the home
# directory is persistent. On Render/Railway set this to a mounted volume.
# DATA_DIR=/absolute/path/to/data

# API server port (dev). WSGI hosts and platforms inject their own.
PORT=3001

# Sessions and login rate limiting (sane defaults, rarely changed).
SESSION_TTL_HOURS=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=5

# Optional: Exa web search (POST /api/search/web, admin-only).
# Get a key at https://dashboard.exa.ai — leave empty to keep the feature
# switched off; the endpoint then answers 503 instead of failing. Read from
# the environment only — never hard-code or commit it.
EXA_API_KEY=

# Card payments (Paystack). Leave this unset and the storefront hides the card
# option — customers can still pay by bank transfer or on delivery, and those
# orders wait for an admin to confirm the money arrived. Set it to your
# sk_test_/sk_live_ key to switch card payments on: checkout then opens Paystack
# and the backend verifies every transaction server-side against Paystack
# before an order is marked paid. Never commit the key.
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
