# Backend configuration — sleekculture
# Copy this file to .env (in the project root) and adjust values.
# Never commit the real .env to git.

# Port the Flask server listens on
PORT=3001

# Initial admin credentials (used ONLY on first database seed; the password
# is stored as a bcrypt hash, never in plain text). Change them for production.
ADMIN_EMAIL=jnrvinnie@gmail.com
ADMIN_PASSWORD=Vinnievinnie11

# How long admin sessions last, in hours
SESSION_TTL_HOURS=8

# How long customer sessions last, in days
USER_SESSION_TTL_DAYS=30

# Login rate limiting
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=5

# Set to 1 in production so session cookies require HTTPS
COOKIE_SECURE=0

# Where the SQLite database and uploaded images live
# (default: <project root>/data). On hosts with a volume, point this at it.
# DATA_DIR=/app/data
